# 多模态模型 API 配置（OpenAI 兼容接口，如 xAI/通义千问/OpenAI 等）
# API Key 从对应平台获取
API_KEY=your_api_key_here
# 接口地址，按所用平台填写，例如：
#   xAI:            https://api.x.ai/v1
#   阿里通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:         https://api.openai.com/v1
BASE_URL=https://api.x.ai/v1
# 模型名称，需为多模态（视觉）模型，例如 grok-2-vision-1212、qwen-vl-max
MODEL_NAME=grok-2-vision-1212

# Tushare token（https://tushare.pro 注册获取）
# 积分门槛：daily 需 120 积分；fina_indicator / top_list 需 2000 积分
# 积分不足的接口返回空数据，不影响其他功能
TUSHARE_TOKEN=your_tushare_token_here
